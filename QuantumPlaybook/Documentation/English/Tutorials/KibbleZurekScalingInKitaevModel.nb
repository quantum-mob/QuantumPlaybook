Cell[TextData[{
 "The above result shows that for fast ramp ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"J", "\[VeryThinSpace]", 
      SubscriptBox["\[Tau]", "Q"]}], "<", "1"}]}], TraditionalForm]],
  ExpressionUUID->"07d21f82-d177-435b-9779-da351fc308f9"],
 "), the system is in the diabatic limit. From now on, we focus on the regime \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"J", "\[VeryThinSpace]", 
     SubscriptBox["\[Tau]", "Q"]}], ">", "1"}], TraditionalForm]],
  ExpressionUUID->"7a10f5e6-2e6e-45c0-8e37-3d8dd8c9d500"],
 "."
}], "TechNoteText",
 CellID->708507939,ExpressionUUID->"ee373e6e-4f45-4490-8fcb-9645130f9954"],

