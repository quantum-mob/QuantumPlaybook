Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ss", "=", 
   RowBox[{"PowerRange", "[", 
    RowBox[{"1", ",", "100", ",", "1.25"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ss", "//", "Length"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "tau", "]"}]}], ",", 
        RowBox[{"top", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"500", ",", "n2"}], "}"}], ",", "tau"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"n1", ",", "100", ",", "200", ",", "50"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"n2", ",", "100", ",", "200", ",", "50"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"tau", ",", 
        RowBox[{"ss", "^", "2"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"data", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lgnd", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<\[Times]\>\"", ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
    RowBox[{"Tuples", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"100", ",", "200", ",", "50"}], "]"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"100", ",", "200", ",", "50"}], "]"}]}], "}"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[25]:=",
