Cell[CellGroupData[{

Cell["Topological Defect Density: Finite Size", "TechNoteSection",
 CellID->928971383,ExpressionUUID->"2d8f7bd8-bd59-44c1-b596-912338ee3dab"],

Cell[TextData[{
 "Function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"top", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["n", "1"], ",", 
       SubscriptBox["n", "2"]}], "}"}], ",", 
     SubscriptBox["\[Tau]", "Q"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "1b26fe0b-32dd-4464-8265-b9d5cf055897"],
 " returns the topological defect density in the Kitaev model on the periodic \
honeycomb lattice of sizes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "1"], TraditionalForm]],ExpressionUUID->
  "098b3b1c-e7cf-407c-a385-0d7c3558755a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "692be286-2c8c-4d6b-bf4d-0bd1472b2d16"],
 " upon the ramping of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["J", "3"], "(", "t", ")"}], ":=", 
    RowBox[{"J", "\[VeryThinSpace]", 
     RowBox[{"t", "/", 
      SubscriptBox["\[Tau]", "Q"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d831d49c-093f-48ed-8e65-9ae6050b76d8"],
 ". Note that the sizes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "1"], TraditionalForm]],ExpressionUUID->
  "7584948f-e28e-4d38-b8b4-4e3dab53d7ef"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "2f337699-c856-44fc-87a4-abd7f2ecb9f7"],
 " are in the direction of the selected primitive lattice vectors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold"], "1"], TraditionalForm]],ExpressionUUID->
  "ed8eeaf2-641c-4e6e-b125-b97c3d19c110"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["a",
     FontWeight->"Bold"], "2"], TraditionalForm]],ExpressionUUID->
  "4e07f3f3-29b7-4c40-a5d1-0f7c396c70bc"],
 ". It is based on the Landau-Zener estimate in Sengupta et al. (2008) and \
Mondal et al. (2008)."
}], "TechNoteMathCaption",
 CellID->1015920391,ExpressionUUID->"81586626-ee5b-435f-840e-428263276139"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "top", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"top", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n1_", ",", "n2_"}], "}"}], ",", "\[Tau]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k1", ",", "k2", ",", "pp"}], "}"}], ",", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"k1", "=", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"n1", "-", "1"}]}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"Pi", "/", "n1"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k2", "=", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", 
         RowBox[{"n2", "-", "1"}]}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"2", 
         RowBox[{"Pi", "/", "n2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k1", "=", 
      RowBox[{"$J1", "*", 
       RowBox[{"Sin", "[", "k1", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k2", "=", 
      RowBox[{"$J2", "*", 
       RowBox[{"Sin", "[", "k2", "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pp", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi", "*", 
         RowBox[{"\[Tau]", "/", "$J"}]}], ")"}], "*", 
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"#1", "-", "#2"}], "]"}], "^", "2"}], "&"}], ",", "k1", ",",
          "k2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Total", "@", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         RowBox[{"Flatten", "@", "pp"}]}], "]"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"n1", "*", "n2"}], ")"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[14]:=",
 CellID->2079017887,ExpressionUUID->"b8528328-f15e-4d2f-b6d4-76bd9a135e73"],

Cell["Set the coupling parameters:", "TechNoteMathCaption",
 CellID->347206472,ExpressionUUID->"edda538c-0345-4dd7-b2ec-557ba56e3c61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$J1", "=", "0.4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$J2", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$J", "=", "1"}], ";"}]}], "Input",
 CellLabel->"In[16]:=",
 CellID->786106005,ExpressionUUID->"e2a33c49-ed1f-4392-ae23-bb3c6234c0e7"],

Cell[TextData[{
 "Set the scaling variable, which in turns sets the ramping rate parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "Q"], TraditionalForm]],ExpressionUUID->
  "6b8173f3-6457-4ccb-b9a5-806f68137845"],
 ":"
}], "TechNoteMathCaption",
 CellID->764229691,ExpressionUUID->"c9fbd0c2-7918-42d1-847d-7eec8d2cbcca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ss", "=", 
   RowBox[{"PowerRange", "[", 
    RowBox[{"0.01", ",", "100", ",", "1.5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ss", "//", "Length"}]}], "Input",
 CellLabel->"In[19]:=",
 CellID->308723930,ExpressionUUID->"55bd6f3a-8cf6-4e9e-8f34-fbb2fcf3eab1"],

Cell[BoxData["23"], "Output",
 CellLabel->"Out[20]=",
 CellID->1466661850,ExpressionUUID->"c15afefd-6120-41b9-aba1-d2ed6581497f"]
