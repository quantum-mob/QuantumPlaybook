lattice):\
\>", "TechNoteMathCaption",
 CellID->1887043486,ExpressionUUID->"bb5fe282-f02a-4817-b11d-863d61379003"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"bb", "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"RR", ".", 
       RowBox[{"aa", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
     RowBox[{"RR", ".", 
      RowBox[{"aa", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "*", 
   RowBox[{"(", 
    RowBox[{"2", 
     RowBox[{"Pi", "/", "A"}]}], ")"}]}]}]], "Input",
 CellLabel->"In[8]:=",
