Cell["Calculate the defect density:", "TechNoteMathCaption",
 CellID->1930728856,ExpressionUUID->"6941ce14-6077-4aaa-bf75-db0776c21e6a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
   RowBox[{"data", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "tau", "]"}]}], ",", 
        RowBox[{"top", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"500", ",", "n2"}], "}"}], ",", "tau"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"n1", ",", "100", ",", "200", ",", "50"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"n2", ",", "100", ",", "200", ",", "50"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"tau", ",", 
        RowBox[{"ss", "^", "2"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"data", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lgnd", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Row", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<\[Times]\>\"", ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "&"}], "/@", 
    RowBox[{"Tuples", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"100", ",", "200", ",", "50"}], "]"}], ",", 
       RowBox[{"Range", "[", 
        RowBox[{"100", ",", "200", ",", "50"}], "]"}]}], "}"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[21]:=",
 CellID->1281976622,ExpressionUUID->"ef120b5c-4d80-4021-8c9c-0d2c54feb693"],

Cell[BoxData["11.23597`"], "EchoTiming",
 CellID->1368412684,ExpressionUUID->"ba1e00c5-e635-46e7-8f98-e9cde7239f59"]
}, Open  ]],

