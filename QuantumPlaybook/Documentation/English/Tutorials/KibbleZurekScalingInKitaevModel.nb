Cell[TextData[{
 "So, the defect density, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["N", "top"], "/", 
     SubscriptBox["N", "1"]}], 
    SubscriptBox["N", "2"]}], TraditionalForm]],ExpressionUUID->
  "ff63a31b-92dc-4366-9e0d-97bcf4f42aa3"],
 ", is a universal linear function of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox[
     SubscriptBox["\[Tau]", "Q"]]}], TraditionalForm]],ExpressionUUID->
  "0ad611fe-18a4-4cf3-8597-d2313703831c"],
 "."
}], "TechNoteText",
 CellID->646343712,ExpressionUUID->"714124af-3262-4028-b272-c4479a7ee475"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Topological Defect Density: Thermodynamic Limit", "TechNoteSection",
 CellID->1126481058,ExpressionUUID->"41fe8e40-6363-4103-a319-a16172e9be7f"],

Cell[TextData[{
 "Function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"topInfty", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["J", "1"], ",", 
       SubscriptBox["J", "2"]}], "}"}], ",", 
     SubscriptBox["\[Tau]", "Q"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "d8741c82-03de-4e73-a91c-23d6f371c8ec"],
 " returns the topological defect density in the Kitaev model in the \
thermodynamic limit. It is based on the same Landau-Zener estimate in \
Sengupta et al. (2008) and Mondal et al. (2008)."
}], "TechNoteMathCaption",
 CellID->551309854,ExpressionUUID->"aff93de7-8e94-4376-b32f-abdf98aa4eeb"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "topInfty", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"topInfty", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"j1_", ",", "j2_"}], "}"}], ",", "\[Tau]_", ",", "opts___"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k1", ",", "k2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2."}], "*", "Pi", "*", "\[Tau]", "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"j1", "*", 
             RowBox[{"Sin", "[", "k1", "]"}]}], "-", 
            RowBox[{"j2", "*", 
             RowBox[{"Sin", "[", "k2", "]"}]}]}], ")"}], "^", "2"}]}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k1", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"{", 
        RowBox[{"k2", ",", 
         RowBox[{"-", "Pi"}], ",", "Pi"}], "}"}], ",", "\[IndentingNewLine]", 
       "opts", ",", "\[IndentingNewLine]", 
       RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], 
      "\[IndentingNewLine]", "]"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", "*", "Pi"}], ")"}], "^", "2"}]}]}], "\[IndentingNewLine]",
    "]"}]}]}], "Input",
 CellLabel->"In[1]:=",
 CellID->1620263020,ExpressionUUID->"7d813e9a-c4b7-428c-8cd9-9ffee58d3bee"],

Cell[TextData[{
 "Calculate the defect density as a function of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox[
     SubscriptBox["\[Tau]", "Q"]]}], TraditionalForm]],ExpressionUUID->
  "6412d88c-896a-46bf-9212-77e32cb24905"],
 " to see the scaling behavior:"
}], "TechNoteMathCaption",
 CellID->1667933180,ExpressionUUID->"186f0a72-075b-460f-9640-58a73493a35f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"EchoTiming", "[", "\[IndentingNewLine]", 
   RowBox[{"dataInfty", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "tau", "]"}]}], ",", 
        RowBox[{"topInfty", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"$J1", ",", "$J2"}], "}"}], ",", "tau"}], "]"}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"tau", ",", 
        RowBox[{"ss", "^", "2"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
