Cell[TextData[{
 "Note that the number of topological defects drops exponentially for small \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", ":=", 
    RowBox[{"L", "/", 
     SqrtBox["\[Tau]"]}]}], TraditionalForm]],ExpressionUUID->
  "72254b2b-9fc3-42db-910c-96382c044f4f"],
 " (slow ramping). This is because the momentum can take only half-integer \
multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", "N"}]}], TraditionalForm]],ExpressionUUID->
  "0ced93bd-721b-422e-92ef-ad099cd8a3eb"],
 " and the energy gap vanishes at no momentum. This means that for any finie \
size, there always exists the adiabatic limit."
}], "TechNoteText",
 CellID->1016693084,ExpressionUUID->"d50652ed-154b-4e56-bc46-85bf804a4d41"],

Cell["Get the asymptotic behavior:", "TechNoteMathCaption",
 CellID->689978471,ExpressionUUID->"143491e2-2bed-4fd9-9a90-aedd07e37aeb"],

