Cell["\<\
Here, the Kibble-Zurek scaling is illustrated for the one-dimensional \
transverse-field Ising model. See Dziarmaga (2005) and Damski (2005) for \
details.\
\>", "TechNoteText",
 CellID->1617104745,ExpressionUUID->"a844dea4-6ff6-4b2a-9c0a-c54afbdb5d7b"],

Cell["Set the energy scale of the model:", "TechNoteMathCaption",
 CellID->2066744286,ExpressionUUID->"a2354562-d9d2-484c-85eb-15aced604745"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$J", "=", "1"}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->223224577,ExpressionUUID->"0339ce02-b14d-4d74-9a46-cf944912157d"],

Cell[TextData[{
 "The Landau-Zener formula: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"top", "[", 
    RowBox[{"n", ",", 
     SubscriptBox["\[Tau]", "Q"]}]}], TraditionalForm]],ExpressionUUID->
  "ec839d08-52d5-4cef-bc27-0a6785e262b0"],
 StyleBox["]", "Input"],
 " returns the number of topological excitations after quench of the XXZ \
chain of length ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "5d6dd4cf-76a3-4e4f-aaa3-42409dd3d97b"],
 " and quenching parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Tau]", "Q"], TraditionalForm]],ExpressionUUID->
  "249cf77e-3aa0-4d1c-8fbb-1cdfec16cc3c"],
 ". The initial state is assumed to be the ground state of the XXZ chain."
}], "TechNoteMathCaption",
 CellID->81534330,ExpressionUUID->"43c7e640-400f-439b-9aec-9a7a0fe0fb2c"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "top", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"top", "[", 
   RowBox[{"n_", ",", "\[Tau]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"kk", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"n", "-", "1"}], "]"}]}], ",", "\[IndentingNewLine]", "pp"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"kk", "=", 
      RowBox[{"Pi", "*", 
       RowBox[{"N", "[", 
        RowBox[{"kk", "/", "n"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"pp", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "*", "Pi"}], ")"}], "*", "$J", "*", "\[Tau]", "*", 
       RowBox[{
        RowBox[{"Sin", "[", "kk", "]"}], "^", "2"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Total", "[", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", "pp"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[2]:=",
 CellID->252917524,ExpressionUUID->"d9030979-b128-4d53-9a66-3b3f14e336df"],

Cell[TextData[{
 "Here, it is important to notice that only half-integer multiples of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", "N"}]}], TraditionalForm]],ExpressionUUID->
  "9fc63147-f394-4fa1-864d-85b823972ac5"],
 " are allowed for the momentum; ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "N"], 
     RowBox[{"(", 
      RowBox[{"n", "+", 
       FractionBox["1", "2"]}], ")"}], " "}]}], TraditionalForm]],
  ExpressionUUID->"8bfa8eb8-a639-45e9-b151-0a6fbd06246f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "=", "0"}], ",", "1", ",", "\[Ellipsis]", ",", 
    RowBox[{"N", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "4e7b985d-aaa8-4028-962a-deed60b07002"],
 ". It corresponds to the ",
 StyleBox["anti-periodic",
  FontSlant->"Italic"],
 " boundary condition of the fermion modes, which corresponds to the fermion \
even parity."
}], "TechNoteText",
 CellID->1289894699,ExpressionUUID->"e59bf70a-1023-4473-ba51-8e6af11525d8"],

Cell[TextData[{
 "Take  a range of he scaling variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", ":=", 
    RowBox[{"L", "/", 
     SqrtBox[
      SubscriptBox["\[Tau]", "Q"]]}]}], TraditionalForm]],ExpressionUUID->
  "9fc281a4-2ab6-4f05-ba1d-700b792374a6"],
 ":"
}], "TechNoteMathCaption",
 CellID->914688455,ExpressionUUID->"e2a04550-d62d-4f8b-952d-5a60f6926cd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$ss", "=", 
   RowBox[{"PowerRange", "[", 
    RowBox[{"2", ",", "200", ",", "1.25"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[4]:=",
 CellID->1480917959,ExpressionUUID->"4c9f3157-25ea-4cbd-9bc0-f2bedd273f45"],

Cell["Calculate the number of topological excitations:", "TechNoteMathCaption",
 CellID->452668183,ExpressionUUID->"fde4644b-8c24-4b90-9c2e-44aa1b8db5fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "/", 
           RowBox[{"Sqrt", "[", "t", "]"}]}], ",", 
          RowBox[{"top", "[", 
           RowBox[{"n", ",", "t"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "20", ",", "100", ",", "20"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{
           RowBox[{"n", "^", "2"}], "/", 
           RowBox[{"$ss", "^", "2"}]}]}], "}"}]}], "]"}], "//", "N"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"General", "::", "munfl"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->1607074007,ExpressionUUID->"922ab0ad-f7d7-4b1c-8abf-48314cbdcbff"],

Cell["\<\
Plot the number of the topological excitations and observe the scaling \
behavior:\
\>", "TechNoteMathCaption",
 CellID->1191007330,ExpressionUUID->"75052023-2c17-4eb0-83f1-bc3a05610dbb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fig1a", "=", 
  RowBox[{"ListLogLogPlot", "[", 
   RowBox[{"data", ",", "\[IndentingNewLine]", 
    RowBox[{"PlotMarkers", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Range", "[", 
      RowBox[{"20", ",", "100", ",", "20"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<L/\!\(\*SqrtBox[\(\[Tau]\)]\)\>\"", 
       ",", "\"\<\!\(\*SubscriptBox[\(N\), \(top\)]\)\>\""}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[6]:=",
 CellID->565121623,ExpressionUUID->"b8dc0d43-b061-4dc9-a474-58301e79208b"],

